{
  "name": "zerochat",
  "private": true,
  "version": "10.34.0",
  "description": "ZeroChat - Cliente Web Universal de Chat con soporte multimodelo, razonamiento autónomo y RAG local",
  "scripts": {
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:managed-services": "node scripts/build-managed-services.mjs",
    "build:sandbox": "node scripts/build-sandbox-script.mjs",
    "build:backend": "npm run build:managed-services && npm run build:sandbox && node scripts/build-backend.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "build": "npm run build:vendor && npm run build:backend",
    "bump": "node scripts/bump-version.mjs",
    "lint": "uvx ruff@0.17.5 check && npx --yes pyright@1.1.414",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test": "node scripts/test-runner.mjs",
    "test:all": "node scripts/test-runner.mjs --all",
    "test:changed": "node scripts/test-runner.mjs --changed",
    "test:unit": "node scripts/test-runner.mjs --level=unit",
    "test:integration": "node scripts/test-runner.mjs --level=integration",
    "test:browser": "node scripts/test-runner.mjs --level=browser",
    "test:architecture": "node scripts/test-runner.mjs --level=architecture",
    "test:infrastructure": "node scripts/test-runner.mjs --level=infrastructure",
    "test:group": "node scripts/test-runner.mjs --group"
  },
  "dependencies": {
    "@orama/orama": "3.1.18",
    "fflate": "0.8.3",
    "mammoth": "1.13.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "playwright": "^1.62.1"
  }
}
