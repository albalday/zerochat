{
  "name": "zerochat",
  "private": true,
  "version": "6.8.4",
  "description": "ZeroChat - Cliente Web Universal de Chat con soporte multimodelo, razonamiento autónomo y RAG local embebido en un solo archivo",
  "scripts": {
    "build:vendor": "node scripts/build-orama.mjs",
    "build": "npm run build:vendor && python3 bundle.py index.html zerochat.html",
    "test": "node scripts/test-runner.mjs",
    "test:unit": "node scripts/test-runner.mjs --level=unit",
    "test:integration": "node scripts/test-runner.mjs --level=integration",
    "test:browser": "node scripts/test-runner.mjs --level=browser",
    "test:architecture": "node scripts/test-runner.mjs --level=architecture",
    "test:infrastructure": "node scripts/test-runner.mjs --level=infrastructure",
    "test:group": "node scripts/test-runner.mjs --group"
  },
  "dependencies": {
    "@orama/orama": "3.1.18"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "playwright": "^1.62.1"
  }
}
