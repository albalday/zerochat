{
  "schemaVersion": 1,
  "id": "playwright",
  "displayName": { "es": "Playwright MCP", "en": "Playwright MCP" },
  "description": {
    "es": "Servidor MCP oficial de Microsoft para automatizar un navegador.",
    "en": "Microsoft's official MCP server for browser automation."
  },
  "homepage": "https://github.com/microsoft/playwright-mcp",
  "enabledByDefault": true,
  "transport": "stdio",
  "launch": {
    "executable": "${nodeExecutable}",
    "args": ["${serviceDir}/node_modules/@playwright/mcp/cli.js", "--headless", "--isolated", "--browser", "chromium"],
    "cwd": "${serviceDir}",
    "env": { "PLAYWRIGHT_BROWSERS_PATH": "${browsersDir}" },
    "handshakeTimeoutSeconds": 30
  }
}
