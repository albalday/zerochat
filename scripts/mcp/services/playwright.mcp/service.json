{
  "schemaVersion": 1,
  "id": "playwright",
  "displayName": {
    "es": "Playwright MCP",
    "en": "Playwright MCP"
  },
  "description": {
    "es": "Automatización de navegador mediante el servidor MCP oficial de Playwright.",
    "en": "Browser automation through the official Playwright MCP server."
  },
  "enabledByDefault": false,
  "transport": "stdio",
  "launch": {
    "executable": "${nodeExecutable}",
    "args": ["${serviceDir}/node_modules/@playwright/mcp/cli.js", "--headless", "--browser=chromium"],
    "cwd": "${serviceDir}",
    "env": {},
    "handshakeTimeoutSeconds": 30
  }
}
