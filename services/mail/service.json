{
  "schemaVersion": 1,
  "id": "mail",
  "version": "1.1.1",
  "displayName": {
    "es": "Correo (IMAP / SMTP)",
    "en": "Email (IMAP / SMTP)"
  },
  "description": {
    "es": "Lee, busca y crea borradores por IMAP y envía mensajes por SMTP (desactivado por defecto), con adjuntos desde su carpeta de salida. Funciona con Gmail usando una contraseña de aplicación y con cualquier servidor IMAP/SMTP estándar.",
    "en": "Read, search and create drafts via IMAP and send messages via SMTP (disabled by default), with attachments from its outbox folder. Works with Gmail using an App Password and with any standard IMAP/SMTP server."
  },
  "help": {
    "url": "https://myaccount.google.com/apppasswords",
    "label": {
      "es": "Crear contraseña de aplicación de Google",
      "en": "Create a Google App Password"
    }
  },
  "transport": "stdio",
  "options": [
    {
      "id": "MAIL_IMAP_HOST",
      "type": "text",
      "required": true,
      "label": {
        "es": "Servidor IMAP",
        "en": "IMAP server"
      },
      "placeholder": {
        "es": "imap.gmail.com",
        "en": "imap.gmail.com"
      }
    },
    {
      "id": "MAIL_USER",
      "type": "text",
      "required": true,
      "label": {
        "es": "Correo o usuario",
        "en": "Email address or username"
      },
      "placeholder": {
        "es": "usuario@ejemplo.com",
        "en": "user@example.com"
      }
    }
  ],
  "secrets": [
    {
      "name": "MAIL_PASSWORD",
      "label": {
        "es": "Contraseña o contraseña de aplicación",
        "en": "Password or App Password"
      }
    }
  ],
  "tools": {
    "list_folders": {
      "enabledByDefault": true
    },
    "search_messages": {
      "enabledByDefault": true
    },
    "read_message": {
      "enabledByDefault": true
    },
    "create_draft": {
      "enabledByDefault": true
    },
    "send_email": {
      "enabledByDefault": false
    }
  },
  "rateLimit": {
    "concurrency": 2,
    "minIntervalS": 0.2
  },
  "launch": {
    "executable": "${pythonExecutable}",
    "args": [
      "${serviceDir}/mail_mcp_server.py"
    ],
    "env": {
      "MAIL_IMAP_HOST": "${option:MAIL_IMAP_HOST}",
      "MAIL_USER": "${option:MAIL_USER}",
      "MAIL_PASSWORD": "${secret:MAIL_PASSWORD}"
    },
    "handshakeTimeoutSeconds": 15,
    "callTimeoutSeconds": 120
  }
}
