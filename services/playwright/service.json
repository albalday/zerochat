{
  "schemaVersion": 1,
  "id": "playwright",
  "version": "1.2.1",
  "displayName": {
    "es": "Playwright MCP",
    "en": "Playwright MCP"
  },
  "description": {
    "es": "Automatización de navegador mediante el servidor MCP oficial de Playwright.",
    "en": "Browser automation through the official Playwright MCP server."
  },
  "transport": "stdio",
  "launch": {
    "executable": "${nodeExecutable}",
    "args": ["${serviceDir}/node_modules/@playwright/mcp/cli.js", "--caps=vision,storage"],
    "env": {},
    "handshakeTimeoutSeconds": 30,
    "callTimeoutSeconds": 120
  },
  "tools": {
    "browser_cookie_clear": { "enabledByDefault": false },
    "browser_cookie_delete": { "enabledByDefault": false },
    "browser_cookie_get": { "enabledByDefault": false },
    "browser_cookie_list": { "enabledByDefault": false },
    "browser_cookie_set": { "enabledByDefault": false },
    "browser_localstorage_clear": { "enabledByDefault": false },
    "browser_localstorage_delete": { "enabledByDefault": false },
    "browser_localstorage_get": { "enabledByDefault": false },
    "browser_localstorage_list": { "enabledByDefault": false },
    "browser_localstorage_set": { "enabledByDefault": false },
    "browser_sessionstorage_clear": { "enabledByDefault": false },
    "browser_sessionstorage_delete": { "enabledByDefault": false },
    "browser_sessionstorage_get": { "enabledByDefault": false },
    "browser_sessionstorage_list": { "enabledByDefault": false },
    "browser_sessionstorage_set": { "enabledByDefault": false },
    "browser_run_code_unsafe": { "enabledByDefault": false },
    "browser_storage_state": { "enabledByDefault": false },
    "browser_set_storage_state": { "enabledByDefault": false }
  }
}
